# ==============================================================================
# RogueForge v1.0.0-rc2 testing - Environment Configuration
# ==============================================================================
#
# RogueForge deployment directory:
#
#   /opt/media-server/rogueforge
#
# Expected host layout:
#
#   /opt/media-server/
#   ├── rogueforge/
#   │   ├── compose.yaml
#   │   ├── .env
#   │   ├── update.sh
#   │   ├── setup-auth.py
#   │   └── data/
#   │       ├── auth.json
#   │       └── operations.json
#   ├── qbittorrent/
#   ├── prowlarr/
#   ├── radarr/
#   ├── sonarr/
#   ├── bazarr/
#   ├── rogue-dashboard/
#   └── other Compose stacks...
#
# Copy this file to ".env" if installing manually:
#
#   cd /opt/media-server/rogueforge
#   cp .env.example .env
#   nano .env
#
# IMPORTANT:
# - RogueForge's OWN deployment files live in /opt/media-server/rogueforge.
# - ROGUEFORGE_MEDIA_ROOT / COMPOSE_ROOT / ENV_ROOT remain /opt/media-server
#   because RogueForge must be able to discover and manage sibling media stacks.
# - Changes to this file require the RogueForge container to be recreated.
# - Do not publish a populated .env if it contains private URLs or future secrets.
# ==============================================================================


# ------------------------------------------------------------------------------
# Deployment / Container
# ------------------------------------------------------------------------------

# Host directory containing RogueForge's compose.yaml, .env, scripts and data/.
# This value is primarily used by host-side install/update tooling.
ROGUEFORGE_INSTALL_DIR=/opt/media-server/rogueforge

# Host directory containing persistent RogueForge state.
# compose.yaml mounts this directory to /opt/rogueforge/data inside the container.
ROGUEFORGE_DATA_DIR=/opt/media-server/rogueforge/data

# Host port used to open RogueForge directly.
# Container port 7810 remains internal and normally does not need changing.
ROGUEFORGE_HOST_PORT=17810

# Container image to run.
# Testing channel / release-candidate image:
ROGUEFORGE_IMAGE=ghcr.io/rogueassassin/rogueforge:1.0.0-rc2
# Rolling testing alternative:
# ROGUEFORGE_IMAGE=ghcr.io/rogueassassin/rogueforge:testing
# Stable production alternative after 1.0.0 promotion:
# ROGUEFORGE_IMAGE=ghcr.io/rogueassassin/rogueforge:latest

# Deployment runtime used by install.sh/update.sh on the HOST.
# Supported values: podman, docker
ROGUEFORGE_DEPLOY_ENGINE=podman

# Runtime RogueForge controls through the mounted engine socket.
# Normally this matches ROGUEFORGE_DEPLOY_ENGINE.
ROGUEFORGE_ENGINE=podman

# Existing Docker/Podman network shared with RogueDashboard, reverse proxy and
# other media services that need to reach RogueForge by container name.
ROGUEFORGE_NETWORK=media-net

# Compose project/container name RogueForge protects from managing itself.
ROGUEFORGE_SELF_STACK=rogueforge


# ------------------------------------------------------------------------------
# Podman / Docker Engine Socket
# ------------------------------------------------------------------------------

# HOST socket mounted into the RogueForge container.
#
# Rootless Podman normally uses:
#   /run/user/<UID>/podman/podman.sock
#
# IMPORTANT: replace 1000 if the container-owning Linux account uses another UID.
# Check with:
#   id -u
ROGUEFORGE_SOCKET_SOURCE=/run/user/1000/podman/podman.sock

# Socket path INSIDE the RogueForge container.
# Normally leave this unchanged.
ROGUEFORGE_SOCKET_TARGET=/run/podman/podman.sock

# Engine endpoint used by Podman/Docker CLI calls inside RogueForge.
ROGUEFORGE_CONTAINER_HOST=unix:///run/podman/podman.sock

# true  = use Podman remote mode against the mounted host socket.
# false = normal setting for Docker deployments.
ROGUEFORGE_PODMAN_REMOTE=true

# Docker deployment example:
# ROGUEFORGE_DEPLOY_ENGINE=docker
# ROGUEFORGE_ENGINE=docker
# ROGUEFORGE_SOCKET_SOURCE=/var/run/docker.sock
# ROGUEFORGE_SOCKET_TARGET=/var/run/docker.sock
# ROGUEFORGE_CONTAINER_HOST=unix:///var/run/docker.sock
# ROGUEFORGE_PODMAN_REMOTE=false


# ------------------------------------------------------------------------------
# Media / Compose Discovery Paths
# ------------------------------------------------------------------------------

# Root of the host media-server deployment.
# compose.yaml mounts this path into RogueForge at the SAME absolute path.
ROGUEFORGE_MEDIA_ROOT=/opt/media-server

# Directory RogueForge recursively scans for compose.yaml/docker-compose.yml.
#
# Your stacks live directly below /opt/media-server, for example:
#   /opt/media-server/radarr/compose.yaml
#   /opt/media-server/sonarr/compose.yaml
#   /opt/media-server/rogueforge/compose.yaml
#
# Therefore the correct default is /opt/media-server, NOT /opt/media-server/compose.
ROGUEFORGE_COMPOSE_ROOT=/opt/media-server

# Root containing each stack's .env using the same relative layout as COMPOSE_ROOT.
# Because your .env files live beside each stack's compose.yaml, use /opt/media-server.
ROGUEFORGE_ENV_ROOT=/opt/media-server

# Compatibility alias retained for older RogueForge installs.
# Keep this identical to ROGUEFORGE_COMPOSE_ROOT.
ROGUEFORGE_STACKS_DIR=/opt/media-server

# Maximum recursive directory depth used while discovering Compose projects.
# 3 is appropriate for /opt/media-server/<stack>/compose.yaml layouts.
# Higher values find deeper nested stacks but increase filesystem scanning work.
ROGUEFORGE_SCAN_DEPTH=3

# Seconds to cache Compose discovery results.
# Lower = filesystem changes appear sooner.
# Higher = less scanning work.
ROGUEFORGE_DISCOVERY_CACHE=10


# ------------------------------------------------------------------------------
# Persistent RogueForge State
# ------------------------------------------------------------------------------

# Authentication file path INSIDE the RogueForge container.
# The host copy is:
#   /opt/media-server/rogueforge/data/auth.json
ROGUEFORGE_AUTH_FILE=/opt/rogueforge/data/auth.json

# Operations/audit history path INSIDE the RogueForge container.
# The host copy is:
#   /opt/media-server/rogueforge/data/operations.json
ROGUEFORGE_OPERATIONS_FILE=/opt/rogueforge/data/operations.json

# Administrator session lifetime in seconds.
# 43200 = 12 hours.
ROGUEFORGE_SESSION_TTL=43200


# ------------------------------------------------------------------------------
# RogueDashboard / Reverse Proxy Integration
# ------------------------------------------------------------------------------

# RogueDashboard icon directory visible through the /opt/media-server mount.
# RogueForge uses these icons when matching known media applications.
ROGUEFORGE_ICONS_DIR=/opt/media-server/rogue-dashboard/app/static/icons

# Public HTTPS URL for RogueForge.
# Used for deployment/status information and should match your reverse proxy URL.
ROGUEFORGE_PUBLIC_URL=https://manage.roguegaming.com.au


# ------------------------------------------------------------------------------
# Lifecycle Operations / Safety
# ------------------------------------------------------------------------------

# Maximum seconds allowed for a single Compose step such as pull/recreate.
# If exceeded, RogueForge terminates the process and marks the operation timed out.
ROGUEFORGE_OPERATION_TIMEOUT=900

# Seconds RogueForge waits after terminate before escalating to a hard kill.
ROGUEFORGE_OPERATION_TERMINATE_GRACE=10

# Maximum time RogueForge waits for Start/Stop/Restart/Update verification.
# Verification runs ONLY while an action is active; there is no permanent poller.
ROGUEFORGE_LIFECYCLE_VERIFY_TIMEOUT=30

# Seconds between lifecycle verification samples.
# 0.5 gives fast feedback without creating meaningful steady-state load.
ROGUEFORGE_LIFECYCLE_VERIFY_INTERVAL=0.5

# Consecutive successful samples required before an operation is declared healthy.
# 2 prevents a single transient runtime response from being treated as success.
ROGUEFORGE_LIFECYCLE_STABLE_SAMPLES=2


# ------------------------------------------------------------------------------
# Dashboard / Runtime Performance
# ------------------------------------------------------------------------------

# Seconds to reuse one Docker/Podman container inventory snapshot.
# This prevents repeated engine calls when several UI sections refresh together.
ROGUEFORGE_INVENTORY_CACHE=2

# Fresh dashboard snapshot lifetime in seconds.
# Small values keep the UI current while still coalescing duplicate requests.
ROGUEFORGE_DASHBOARD_CACHE=3

# Maximum age of a dashboard snapshot that may be returned immediately while one
# background refresh rebuilds the current state.
ROGUEFORGE_DASHBOARD_STALE=30

# Seconds to cache Images / Volumes / Networks inventory and usage relationships.
# These pages are loaded on demand, so 15 is a good low-overhead default.
ROGUEFORGE_RESOURCE_CACHE=15

# Maximum concurrent engine-detail requests such as inspect/stats.
# Prevents a busy browser from flooding the Podman/Docker socket.
ROGUEFORGE_ENGINE_DETAIL_CONCURRENCY=4


# ------------------------------------------------------------------------------
# Live Logs
# ------------------------------------------------------------------------------

# Number of historical lines included when opening a live log stream.
# Live logs then continue in real time.
# Logs are streamed on demand only; RogueForge does NOT run a server-side log
# database/indexer or continuously tail every container.
ROGUEFORGE_LOG_TAIL=200

# Maximum simultaneous live-log streams.
# Keeps memory/process usage bounded if several browser tabs are open.
ROGUEFORGE_MAX_LOG_STREAMS=6


# ------------------------------------------------------------------------------
# Container Terminal
# ------------------------------------------------------------------------------

# Maximum simultaneous authenticated terminal sessions.
ROGUEFORGE_MAX_TERMINALS=4

# Close an idle terminal after this many seconds.
# 1800 = 30 minutes.
ROGUEFORGE_TERMINAL_TTL=1800

# Absolute maximum lifetime for one terminal even if it remains active.
# 7200 = 2 hours.
ROGUEFORGE_TERMINAL_MAX_LIFETIME=7200


# ------------------------------------------------------------------------------
# Optional / Advanced
# ------------------------------------------------------------------------------

# Channel marker used by update tooling.
# Normal values: testing or production
ROGUEFORGE_CHANNEL=testing

# Demo mode disables real container-engine access.
# Leave false/blank for normal deployments.
ROGUEFORGE_DEMO=false
