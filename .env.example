ROGUEFORGE_HOST_PORT=17810
ROGUEFORGE_IMAGE=ghcr.io/rogueassassin/rogueforge:0.8.8
ROGUEFORGE_DEPLOY_ENGINE=podman
ROGUEFORGE_ENGINE=podman
ROGUEFORGE_SOCKET_SOURCE=/run/user/1000/podman/podman.sock
ROGUEFORGE_SOCKET_TARGET=/run/podman/podman.sock
ROGUEFORGE_CONTAINER_HOST=unix:///run/podman/podman.sock
ROGUEFORGE_PODMAN_REMOTE=true

# Mount root visible inside RogueForge. Compose and env roots should live beneath it.
ROGUEFORGE_MEDIA_ROOT=/opt/media-server
# Directory RogueForge scans for stack compose.yaml/docker-compose.yml files.
ROGUEFORGE_COMPOSE_ROOT=/opt/media-server/compose
# Root containing .env files using the same relative stack layout as COMPOSE_ROOT.
ROGUEFORGE_ENV_ROOT=/opt/media-server/compose
# Compatibility alias used by older RogueForge installs; updater keeps it synced.
ROGUEFORGE_STACKS_DIR=/opt/media-server/compose

ROGUEFORGE_SCAN_DEPTH=3
ROGUEFORGE_DISCOVERY_CACHE=10
# Share one Podman inventory snapshot between simultaneous dashboard requests.
ROGUEFORGE_INVENTORY_CACHE=2
ROGUEFORGE_ICONS_DIR=/opt/media-server/rogue-dashboard/app/static/icons
ROGUEFORGE_SELF_STACK=rogueforge
ROGUEFORGE_PUBLIC_URL=https://manage.roguegaming.com.au
ROGUEFORGE_NETWORK=media-net

# Maximum seconds for a single long-running Compose step before RogueForge terminates it.
ROGUEFORGE_OPERATION_TIMEOUT=900
# Grace period after terminate before RogueForge escalates to kill.
ROGUEFORGE_OPERATION_TERMINATE_GRACE=10
