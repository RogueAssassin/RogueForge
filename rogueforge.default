ROGUEFORGE_BIND=127.0.0.1
ROGUEFORGE_PORT=7810
# This is the directory RogueForge scans for Compose projects.
# It is separate from the RogueForge application directory.
ROGUEFORGE_STACKS_DIR=/opt/stacks
ROGUEFORGE_ENGINE=auto
# ROGUEFORGE_SOCKET=/run/podman/podman.sock
# For rootless Podman, set both values (replace the user and UID):
# ROGUEFORGE_PODMAN_USER=rogue
# ROGUEFORGE_SOCKET=/run/user/1000/podman/podman.sock
# ROGUEFORGE_PUBLIC_URL=https://manage.example.com
ROGUEFORGE_PODMAN_COMPOSE=/usr/bin/podman-compose
ROGUEFORGE_PODMAN=/usr/bin/podman
ROGUEFORGE_DOCKER=/usr/bin/docker
# ROGUEFORGE_DEMO=false
