[Unit]
Description=RogueForge Docker/Podman Stack Manager
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@STACKS_DIR@

[Service]
Type=simple
EnvironmentFile=-@CONFIG_FILE@
ExecStart=/usr/bin/python3 @INSTALL_DIR@/rogueforge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@STACKS_DIR@
ReadOnlyPaths=/run/podman/podman.sock /var/run/docker.sock
ProtectHome=@PROTECT_HOME@

[Install]
WantedBy=multi-user.target
